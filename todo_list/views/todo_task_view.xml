    <record id="todo_action" model="ir.actions.act_window">
        <field name="name">Todo Task</field>
        <field name="res_model">todo.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="task_kanban_view"/>
        <field name="search_view_id" ref="task_view_search"/>
    </record>

    <menuitem
            id="assign_task_menu_item"
            name="Assign Task"
            parent="tasks_menu"
            action="todo_action"
    />
</odoo>