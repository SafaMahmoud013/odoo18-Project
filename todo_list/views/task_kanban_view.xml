<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="task_kanban_view" model="ir.ui.view">
        <field name="name">todo.task.kanban</field>
        <field name="model">todo.task</field>

        <field name="arch" type="xml">
            <kanban>

                <field name="name"/>
                <field name="description"/>
                <field name="assigned_to"/>
                <field name="due_date"/>
                <field name="status"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3 border rounded">

                            <h5 class="mb-2">
                                <i class="fa fa-tasks me-2"/>
                                <field name="name"/>
                            </h5>

                            <div class="mb-2">
                                <i class="fa fa-align-left me-2 text-secondary"/><!-- text-secondary make font color grey-->
                                <b>Description:</b>
                                <br/>
                                <field name="description"/>
                            </div>

                            <hr/>

                            <div class="mb-2">
                                <i class="fa fa-user me-2 text-primary"/>
                                <b>Assigned To:</b>
                                <field name="assigned_to"/>
                            </div>

                            <div class="mb-2">
                                <i class="fa fa-calendar me-2 text-danger"/>
                                <b>Due Date:</b>
                                <field name="due_date"/>
                            </div>

                            <div class="mb-2">
                                <i class="fa fa-flag me-2 text-success"/>
                                <b>Status:</b>
                                <field name="status" widget="badge"/>
                            </div>

                            <div class="mb-2">
                                <i class="fa fa-star me-2 text-warning"/>
                                <b>Priority:</b>
                                <field name="priority" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>

            </kanban>
        </field>
    </record>

</odoo>